{
  "name": "@foghaven/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run tokens:build && tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint:i18n": "eslint src --no-warn-ignored",
    "tokens:build": "tsx scripts/generate-tokens.ts"
  },
  "dependencies": {
    "@colyseus/schema": "^2.0.0",
    "@foghaven/shared": "*",
    "@sentry/react": "^10.0.0",
    "colyseus.js": "^0.15.0",
    "i18next": "^23.11.0",
    "phaser": "^3.80.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-i18next": "^14.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^10.0.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.2.0",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^2.1.9"
  }
}
