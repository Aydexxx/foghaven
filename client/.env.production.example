# Production build config for the Foghaven web client.
#
# These are BUILD-TIME values — Vite inlines import.meta.env when the client is
# built, so they must be set on the client's build (Railway build args, or the
# Netlify/Vercel build environment), NOT at runtime.

# The deployed Colyseus server's public origin, over TLS (wss://). The client
# derives the HTTP auth/friends/stats API base from this too (ws->http), so a
# single value covers both the game socket and the REST calls.
VITE_SERVER_URL=wss://your-foghaven-server.up.railway.app

# Optional override if the HTTP API is served from a different origin than the
# game socket. Leave unset when one server serves both (the normal case).
# VITE_AUTH_URL=https://your-foghaven-server.up.railway.app

# Sentry DSN for client-side error tracking. Unset disables Sentry entirely —
# see docs/DEPLOYMENT.md's Observability section.
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
