# Copy to server/.env (git-ignored) and fill in. NEVER commit a real .env.
#
# In a cloud deploy (Railway) these come from the platform environment, not a
# committed file — PORT, DATABASE_URL and REDIS_URL are injected by Railway /
# its Postgres+Redis plugins. See server/.env.production.example for the exact
# set a production environment must define, and docs/DEPLOYMENT.md for how.

# Port the Foghaven game server listens on (WebSocket + monitor + auth HTTP).
# Injected by the platform in cloud deploys.
PORT=2567

# Postgres connection string. Matches the dev credentials in the root
# docker-compose.yml; production must supply its own.
DATABASE_URL="postgresql://foghaven:foghaven_dev@localhost:5432/foghaven?schema=public"

# Secret used to sign auth JWTs. MUST be set, and MUST be a long random string
# in production — generate one with e.g. `openssl rand -base64 48`. The server
# refuses to start in production if this is unset or left at a placeholder.
JWT_SECRET="dev-only-change-me-to-a-long-random-string"

# How long an issued auth token stays valid (any `jsonwebtoken` duration).
JWT_EXPIRES_IN="7d"

# bcrypt cost factor. 12 is a sensible default; higher is slower but stronger.
BCRYPT_COST=12

# Whether guests (no account, display-name only) may join rooms at all. Guests
# can never create rooms and can never be banned — set to "false" for an
# accounts-only deployment.
ALLOW_GUESTS=true

# Comma-separated list of browser origins allowed to call the auth HTTP API
# (the Vite dev client). Production sets this to the real web origin.
CLIENT_ORIGIN="http://localhost:5173"

# Set to "production" in prod so the server enforces a real JWT_SECRET.
NODE_ENV=development

# Redis connection string, used for online-presence tracking (see
# server/src/presence/) and, when COLYSEUS_DRIVER=redis, for Colyseus's shared
# room registry too. Matches the dev credentials in the root docker-compose.yml;
# production must supply its own (injected by the Railway Redis plugin).
REDIS_URL="redis://localhost:6380"

# --- Scaling / matchmaking ------------------------------------------------
# How Colyseus keeps its room registry. "local" (default) uses in-memory
# presence+driver — correct and fastest for a SINGLE instance (dev, or a
# one-instance production deploy). Set to "redis" ONLY when running more than
# one server instance: it switches Colyseus to the shared RedisPresence +
# RedisDriver so every instance sees every room. Flipping this on REQUIRES
# REDIS_URL and PUBLIC_ADDRESS (below). See docs/DEPLOYMENT.md.
COLYSEUS_DRIVER=local

# This instance's externally reachable host:port, advertised to clients for
# room-aware routing. Required only when COLYSEUS_DRIVER=redis. Ignored in
# local mode.
# PUBLIC_ADDRESS="foghaven-server.up.railway.app"

# --- Colyseus monitor -----------------------------------------------------
# The room dashboard at /colyseus exposes live room + client detail. It is
# protected by HTTP basic auth when both of these are set; if NODE_ENV is
# "production" and they are NOT set, the monitor is not mounted at all.
# MONITOR_USER="admin"
# MONITOR_PASSWORD="a-long-random-password"

# --- Observability ---------------------------------------------------------
# Sentry DSN for server-side error tracking (uncaught room exceptions, HTTP
# errors, process-level crashes — see server/src/index.ts). Unset disables
# Sentry entirely; nothing else here depends on it. See docs/DEPLOYMENT.md's
# Observability section.
# SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"

# Bearer token gating GET /metrics (Prometheus exposition — see
# server/src/metrics.ts). Unset leaves /metrics open with no auth, which is
# fine for local dev but not recommended once deployed. Also set as
# FOGHAVEN_METRICS_TOKEN on the Grafana Alloy service (observability/alloy/)
# so it can actually scrape this.
# METRICS_TOKEN="a-long-random-string"

# --- Proximity voice (WebRTC) --------------------------------------------
# STUN/TURN servers handed to clients for the voice mesh. STUN alone works for
# most players; TURN is REQUIRED to reach anyone behind a symmetric NAT (common
# on mobile/corporate networks) — without it those players are silent to
# everyone. See server/src/voice/turn.ts.

# Comma-separated STUN urls. Defaults to a public Google STUN server if unset.
VOICE_STUN_URLS="stun:stun.l.google.com:19302"

# Comma-separated TURN urls. Leave unset to disable TURN (dev/direct-path only).
# VOICE_TURN_URLS="turn:turn.example.com:3478,turns:turn.example.com:5349"

# Preferred: coturn's time-limited REST scheme. Set this to coturn's
# `static-auth-secret` and the server mints short-lived per-client credentials.
# VOICE_TURN_SECRET="the-coturn-static-auth-secret"
# VOICE_TURN_TTL_SECONDS=43200

# Alternative: a static long-term TURN credential (if not using a shared secret).
# VOICE_TURN_USERNAME="foghaven"
# VOICE_TURN_CREDENTIAL="a-long-random-password"
