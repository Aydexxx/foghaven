# The variables a PRODUCTION (or staging) Foghaven server environment must
# define. These live in the platform's environment settings (Railway → the
# service → Variables), one set per Railway environment — never in a committed
# file. Staging and production use the SAME keys with different values.
#
# This file lists keys + guidance only, no real values. See docs/DEPLOYMENT.md.

# Injected automatically by Railway and its plugins — you normally do NOT set
# these by hand:
#   PORT              — the port Railway routes to.
#   DATABASE_URL      — from the Railway Postgres plugin.
#   REDIS_URL         — from the Railway Redis plugin.

# Must be set by you:

# "production" — turns on the strict boot-time config checks (a real JWT_SECRET,
# DATABASE_URL, CLIENT_ORIGIN, and — in redis mode — REDIS_URL + PUBLIC_ADDRESS).
NODE_ENV=production

# A long random secret for signing auth JWTs — generate with:
#   openssl rand -base64 48
# The server refuses to boot in production if this is unset or a placeholder.
JWT_SECRET=

# The deployed web client's origin, for CORS on the HTTP API. Comma-separate
# multiple origins. Must match where the client is actually served from.
CLIENT_ORIGIN=https://your-foghaven-client.example

# Whether display-name-only guests may join rooms (they can never create rooms
# or be banned). "false" for an accounts-only deployment.
ALLOW_GUESTS=true

# How long issued auth tokens stay valid (any jsonwebtoken duration).
JWT_EXPIRES_IN=7d

# bcrypt cost factor.
BCRYPT_COST=12

# Colyseus monitor basic-auth credentials. Leave BOTH unset to keep the monitor
# disabled in production (the safe default); set both to enable it.
# MONITOR_USER=
# MONITOR_PASSWORD=

# --- Observability — see docs/DEPLOYMENT.md's Observability section --------
# Sentry project DSN. Unset disables error tracking entirely.
SENTRY_DSN=

# Bearer token gating GET /metrics. Also set as FOGHAVEN_METRICS_TOKEN on the
# Grafana Alloy service (observability/alloy/) so it can scrape this endpoint.
METRICS_TOKEN=

# --- Only when scaling to more than one instance --------------------------
# Leave as-is (single instance) until you actually run multiple instances.
COLYSEUS_DRIVER=local
# PUBLIC_ADDRESS=   # this instance's externally reachable host:port; required in redis mode

# --- Proximity voice (WebRTC) — see server/.env.example for the full set ---
# STUN works for most; TURN is required to reach players behind symmetric NAT.
# VOICE_STUN_URLS=stun:stun.l.google.com:19302
# VOICE_TURN_URLS=
# VOICE_TURN_SECRET=
# VOICE_TURN_TTL_SECONDS=43200
